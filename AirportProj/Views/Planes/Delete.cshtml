@model AirportProj.Models.Plane

@{
    ViewData["Title"] = "Delete";
}
<header>
    <nav class="navbar fixed-top navbar-expand-sm navbar-toggleable-sm navbar-custom border-bottom box-shadow">
        @Html.Partial("AdminNavigation")
    </nav>
</header>
<h1>Видалення запису</h1>
<h3>Ви впевнені, що хочете видалити запис?</h3>
<hr />
<div class="jumbotron">

    <h4>Plane</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MaxDistance)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaxDistance)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Speed)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Speed)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FirstClass)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FirstClass)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BusinessClass)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BusinessClass)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EconomyClass)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EconomyClass)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SerialNum)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SerialNum)
        </dd>
    </dl>

    <br />
    <form asp-action="Delete">
        <input type="hidden" asp-for="PlaneId" />
        <input type="submit" value="Видалити" class="btn btn-danger" /> |
        <a asp-action="Index">Назад до переліку записів</a>
    </form>
</div>
