@model IEnumerable<AirportProj.Models.Passenger>

@{
    ViewData["Title"] = "Index";
}
<header>
    <nav class="navbar fixed-top navbar-expand-sm navbar-toggleable-sm navbar-custom border-bottom box-shadow">
        @Html.Partial("AdminNavigation")
    </nav>
</header>
<header>
    <nav class="navbar fixed-top navbar-expand-sm navbar-toggleable-sm navbar-custom border-bottom box-shadow">
        @Html.Partial("AdminNavigation")
    </nav>
</header>
<h1>Інформація</h1>
<hr />>
<div class="jumbotron">
    <p>
        <a asp-action="Create">Новий запис</a>
    </p>
    <hr />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PassportNum)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Surname)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Initials)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BirthDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PassportNum)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Surname)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Initials)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BirthDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PassengerId">Редагувати</a> |
                <a asp-action="Details" asp-route-id="@item.PassengerId">Детальніше</a> |
                <a asp-action="Delete" asp-route-id="@item.PassengerId">Видалити</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>