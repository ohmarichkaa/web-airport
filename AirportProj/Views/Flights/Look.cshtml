@model AirportProj.Models.Flight

@{
    ViewData["Title"] = "Look";
}

<h1>Детальна інформація про рейс</h1>
<hr />
<div class="jumbotron">
    <dl class="row">
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.FlightNumber)
        </dt>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.DepartureDate)
        </dt>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.DepartureTime)
        </dt>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.FlightNumber)
        </dd>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.DepartureDate)
        </dd>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.DepartureTime)
        </dd>
        <br />
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Destination)
        </dt>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.ArrivalDate)
        </dt>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.ArrivalTime)
        </dt>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.Destination)
        </dd>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.ArrivalDate)
        </dd>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.ArrivalTime)
        </dd>
        <br />
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Aeroport)
        </dt>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Status)
        </dt>

        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Plane)
        </dt>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.Aeroport.Name)
        </dd>

        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.Plane.SerialNum)
        </dd>
        <br />
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.EconomPrice)
        </dt>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.FirstPrice)
        </dt>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.BizPrice)
        </dt>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.EconomPrice)
        </dd>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.FirstPrice)
        </dd>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.BizPrice)
        </dd>
        <br />
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Airline)
        </dt>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Gate.Terminal)
        </dt>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Gate)
        </dt>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.Airline.Name)
        </dd>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.Gate.Terminal.Name)
        </dd>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.Gate.GateNum)
        </dd>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.FlightId)
        </dt>
        <dd class="col-sm-4">
            @Html.DisplayFor(model => model.FlightId)
        </dd>
    </dl>
</div>
<hr />
<div class="jumbotron">
    
    <form asp-action="PurchaseTicket" method="post">
        <input type="hidden" asp-for="FlightId" />
        <div class="form-group">
            <label for="ticketClass">Клас квитка:</label>
            <select id="ticketClass" name="SelectedTicketClass" class="form-control">
                <option value="Econom">Економ-клас</option>
                <option value="First">Перший клас</option>
                <option value="Business">Бізнес-клас</option>
            </select>
        </div>
        <input type="submit" value="Придбати квиток" class="btn btn-dark" />
        <a asp-area="" asp-controller="Home" asp-action="HomePage" class="btn btn-light">Назад до переліку рейсів</a>
    </form>
</div>

