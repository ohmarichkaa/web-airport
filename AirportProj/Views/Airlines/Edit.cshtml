@model AirportProj.Models.Airline

@{
    ViewData["Title"] = "Edit";
}
<header>
    <nav class="navbar fixed-top navbar-expand-sm navbar-toggleable-sm navbar-custom border-bottom box-shadow">
        @Html.Partial("AdminNavigation")
    </nav>
</header>
<h1>Редагування даних</h1>
<hr />
<div class="jumbotron">



<h4>Airline</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AirlineId" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IataCode" class="control-label"></label>
                <input asp-for="IataCode" class="form-control" />
                <span asp-validation-for="IataCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IcaoCode" class="control-label"></label>
                <input asp-for="IcaoCode" class="form-control" />
                <span asp-validation-for="IcaoCode" class="text-danger"></span>
                </div>
                <br />
            <div class="form-group">
                <input type="submit" value="Зберегти" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Назад до переліку записів</a>
</div>

