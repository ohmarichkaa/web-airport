@model IEnumerable<AirportProj.Models.Admin>

@{
    ViewData["Title"] = "Index";
}


<header>
    <nav class="navbar fixed-top navbar-expand-sm navbar-toggleable-sm navbar-custom border-bottom box-shadow ">
        @Html.Partial("AdminNavigation")
    </nav>
</header>

<h1>Інформація</h1>
<hr />

<div class="jumbotron">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Password)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Password)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AdminId">Редагувати</a> 
            </td>
        </tr>
}
    </tbody>
</table>
</div>